# 复制为.env.production后填写；本文件不得放置真实密码、Token或证书。
APP_NAME=sim_trade
APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false
TZ=Asia/Shanghai

# Compose内部服务名；不要改成127.0.0.1。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sim_trade
POSTGRES_USER=sim_trade_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=3
POSTGRES_POOL_RECYCLE_SECONDS=1800
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=10

# 至少32字节的密码学安全随机值。生产启动会拒绝空值或明显弱值。
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ISSUER=sim-trade
AUTH_AUDIENCE=sim-trade-client
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=30
AUTH_PASSWORD_VERIFY_MAX_CONCURRENCY=4
AUTH_PASSWORD_VERIFY_ACQUIRE_TIMEOUT_SECONDS=1
AUTH_REFRESH_COOKIE_NAME=sim_trade_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
API_CORS_ALLOWED_ORIGINS=https://YOUR_PUBLIC_ORIGIN

# Live SDK按实际网络选择lan、TS或local，并始终使用独立策略Token。
REMOTE_MARKET_DATA_MODE=lan
REMOTE_MARKET_DATA_BASE_URL=
REMOTE_MARKET_DATA_API_USER=
REMOTE_MARKET_DATA_API_TOKEN=
# Data SDK在本机使用local且无需Token；改为lan/TS时必须填写下方Token。
YMM_DATA_SDK_MODE=local
YMM_DATA_SDK_TOKEN=
REMOTE_MARKET_DATA_TIMEOUT_SECONDS=3
MARKET_DATABASE_SNAPSHOT_RETRY_SECONDS=15
REMOTE_MARKET_DATA_VERIFY_SSL=true
# 仅在同时启用deploy/compose.ca.yml时设置为容器内路径；否则保持为空。
REMOTE_MARKET_DATA_CA_FILE=

# 产品能力开关须按生产授权审慎开启；股票撮合尚未实现，必须保持false。
OPTION_TRADING_ENABLED=false
COMMODITY_OPTION_TRADING_ENABLED=false
INDEX_OPTION_BUY_TRADING_ENABLED=false
INDEX_OPTION_SHORT_TRADING_ENABLED=false
OPTION_EXERCISE_ENABLED=false
OPTION_COLLATERAL_RATIO=0
STOCK_ORDER_ENTRY_ENABLED=false
STOCK_MATCHING_ENABLED=false

DAILY_SETTLEMENT_TICK_MAX_AGE_SECONDS=14400
ACTIVE_ORDER_REBUILD_BATCH_SIZE=500
ORDER_STREAM_NAME=stream:orders
ORDER_CONSUMER_GROUP=group:order-engine
ORDER_CONSUMER_NAME=
MARKET_TICK_STREAM_NAME=stream:market-ticks
MARKET_MATCHING_CONSUMER_GROUP=group:matching-engine
MARKET_MATCHING_CONSUMER_NAME=
MATCHING_ENGINE_NAME=VN
PNL_CONSUMER_GROUP=group:pnl-engine
PNL_CONSUMER_NAME=
PNL_TRADE_CONSUMER_GROUP=group:pnl-trade-engine
PNL_TRADE_CONSUMER_NAME=
REALTIME_EVENT_STREAM_NAME=stream:realtime-events
REALTIME_PROJECTION_CONSUMER_GROUP=group:realtime-projection
REALTIME_PROJECTION_CONSUMER_NAME=
WS_GATEWAY_CONSUMER_GROUP=group:ws-gateway
WS_GATEWAY_CONSUMER_NAME=
WS_GATEWAY_HOST=0.0.0.0
WS_GATEWAY_PORT=8001

# 宿主机绑定与容器资源/日志上限，可按服务器容量调整。
API_BIND_ADDRESS=127.0.0.1
API_PUBLISHED_PORT=8000
API_LIMIT_CONCURRENCY=24
WS_BIND_ADDRESS=127.0.0.1
WS_PUBLISHED_PORT=8001
# API和行情订阅使用host网络访问Data SDK；数据库端口仅绑定宿主机回环。
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PUBLISHED_PORT=15432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PUBLISHED_PORT=16379
APP_CPUS=1.0
APP_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=1g
REFERENCE_SYNC_CPUS=1.0
REFERENCE_SYNC_MEMORY_LIMIT=2g
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
SIM_TRADE_IMAGE=sim-trade:production
REFERENCE_SYNC_IMAGE=reference-sync:production

# 用户注册门户（目录默认与sim_trade同级）。rootless Docker 使用UID/GID 0；
# rootful Docker 建议使用10001并将数据目录归属设为10001:10001。
USER_REGISTRATION_BUILD_CONTEXT=../user_registration
USER_REGISTRATION_ENV_FILE=../user_registration/.env
USER_REGISTRATION_DATA_DIR=../user_registration/.data
USER_REGISTRATION_IMAGE=user-registration:production
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PUBLISHED_PORT=8008
PORTAL_COOKIE_SECURE=true
PORTAL_UID=10001
PORTAL_GID=10001
PORTAL_CPUS=0.5
PORTAL_MEMORY_LIMIT=512m
