# 应用基础配置
APP_NAME=sim_trade
APP_ENV=dev
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL安全示例配置，请在本地.env中替换
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sim_trade
POSTGRES_USER=sim_trade_app
POSTGRES_PASSWORD=change-me

# Redis安全示例配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=10

# 订单事件Consumer配置
ORDER_STREAM_NAME=stream:orders
ORDER_CONSUMER_GROUP=group:order-engine
ORDER_CONSUMER_NAME=
ORDER_CONSUMER_BATCH_SIZE=100
ORDER_CONSUMER_BLOCK_MS=5000
ORDER_PENDING_IDLE_MS=60000
ORDER_EVENT_MAX_RETRIES=10
ORDER_EVENT_PROCESSED_TTL_SECONDS=604800
ORDER_EVENT_FAILURE_TTL_SECONDS=604800
ORDER_DEAD_LETTER_STREAM=stream:orders:dead-letter
ORDER_CONSUMER_RETRY_INTERVAL_SECONDS=1

# 活动订单索引重建配置
ACTIVE_ORDER_REBUILD_BATCH_SIZE=500
