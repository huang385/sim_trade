# 应用基础配置
APP_NAME=sim_trade
APP_ENV=dev
APP_VERSION=0.1.0
DEBUG=true
DAILY_SETTLEMENT_TICK_MAX_AGE_SECONDS=14400

# PostgreSQL安全示例配置，请在本地.env中替换
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sim_trade
POSTGRES_USER=sim_trade_app
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=3
POSTGRES_POOL_RECYCLE_SECONDS=1800

# Redis安全示例配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=10

# 身份认证。生产环境必须使用密码学安全随机值，至少32字节；不要提交真实密钥。
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ISSUER=sim-trade
AUTH_AUDIENCE=sim-trade-client
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=30
AUTH_PASSWORD_VERIFY_MAX_CONCURRENCY=4
AUTH_PASSWORD_VERIFY_ACQUIRE_TIMEOUT_SECONDS=1
AUTH_REFRESH_COOKIE_NAME=sim_trade_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
API_CORS_ALLOWED_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,http://tauri.localhost,tauri://localhost

# 期权交易默认全部关闭；生产环境必须按产品和账户逐级授权。
OPTION_TRADING_ENABLED=true
COMMODITY_OPTION_TRADING_ENABLED=true
INDEX_OPTION_BUY_TRADING_ENABLED=true
INDEX_OPTION_SHORT_TRADING_ENABLED=false
OPTION_EXERCISE_ENABLED=false
OPTION_COLLATERAL_RATIO=0

# 股票现金订单受理，第二阶段默认关闭
STOCK_ORDER_ENTRY_ENABLED=false
ETF_ORDER_ENTRY_ENABLED=false
# 股票撮合尚未实现，必须保持关闭；该预留开关当前不会把订单接入衍生品撮合或结算。
STOCK_MATCHING_ENABLED=false
ETF_MATCHING_ENABLED=false

# 订单事件Consumer配置
ORDER_STREAM_NAME=stream:orders
ORDER_CONSUMER_GROUP=group:order-engine
ORDER_CONSUMER_NAME=
ORDER_CONSUMER_BATCH_SIZE=100
ORDER_CONSUMER_BLOCK_MS=5000
ORDER_PENDING_IDLE_MS=60000
ORDER_EVENT_MAX_RETRIES=10
ORDER_EVENT_PROCESSED_TTL_SECONDS=604800
ORDER_EVENT_FAILURE_TTL_SECONDS=604800
ORDER_DEAD_LETTER_STREAM=stream:orders:dead-letter
ORDER_CONSUMER_RETRY_INTERVAL_SECONDS=1

# 活动订单索引重建配置
ACTIVE_ORDER_REBUILD_BATCH_SIZE=500

# YMM Live Data客户端。Token保持为空，真实值只写入本地.env。
# Live SDK连接模式，按管理员要求使用lan、TS或local。
REMOTE_MARKET_DATA_MODE=lan
REMOTE_MARKET_DATA_BASE_URL=
FUTURES_MARKET_DATA_API_USER=
FUTURES_MARKET_DATA_API_TOKEN=
SECURITIES_MARKET_DATA_API_USER=
SECURITIES_MARKET_DATA_API_TOKEN=
# Data SDK独立连接模式；local模式无需Token，lan/TS模式必须填写Token。
YMM_DATA_SDK_MODE=local
# 数据库SDK与Live SDK使用不同Token；只在本地.env填写真实值。
YMM_DATA_SDK_TOKEN=
REMOTE_MARKET_DATA_TIMEOUT_SECONDS=3
MARKET_DATABASE_SNAPSHOT_RETRY_SECONDS=15
REMOTE_MARKET_DATA_CA_FILE=
REMOTE_MARKET_DATA_VERIFY_SSL=true

# 行情订阅、重连、本地队列和Redis配置
REMOTE_MARKET_DATA_SUBSCRIPTION_REFRESH_SECONDS=1
REMOTE_MARKET_DATA_SUBSCRIPTION_DEBOUNCE_SECONDS=3
# 期权下单前临时订阅有效期，以及单账户最多同时保留的标准合约代码数。
MARKET_PRE_SUBSCRIPTION_TTL_SECONDS=60
MARKET_PRE_SUBSCRIPTION_MAX_CODES_PER_ACCOUNT=20
MARKET_CLIENT_SUBSCRIPTION_TTL_SECONDS=90
MARKET_CLIENT_SUBSCRIPTION_MAX_CODES_PER_CONNECTION=50
REMOTE_MARKET_DATA_RECONNECT_INITIAL_SECONDS=1
REMOTE_MARKET_DATA_RECONNECT_MAX_SECONDS=30
REMOTE_MARKET_DATA_QUEUE_SIZE=10000
REMOTE_MARKET_DATA_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=10
FUTURES_MARKET_TICK_STREAM_NAME=stream:market-ticks:futures
SECURITIES_MARKET_TICK_STREAM_NAME=stream:market-ticks:securities
FUTURES_MARKET_SOURCE_STATUS_KEY=market:source:ymm_live_data:futures:status
SECURITIES_MARKET_SOURCE_STATUS_KEY=market:source:ymm_live_data:securities:status

# 两个行情域拥有独立撮合和订单到达消费组
FUTURES_MATCHING_CONSUMER_GROUP=group:matching-futures
SECURITIES_MATCHING_CONSUMER_GROUP=group:matching-securities
FUTURES_MATCHING_CONSUMER_NAME=
SECURITIES_MATCHING_CONSUMER_NAME=
FUTURES_ARRIVAL_CONSUMER_GROUP=group:arrival-matching-futures
SECURITIES_ARRIVAL_CONSUMER_GROUP=group:arrival-matching-securities
FUTURES_ARRIVAL_CONSUMER_NAME=
SECURITIES_ARRIVAL_CONSUMER_NAME=
MARKET_MATCHING_BATCH_SIZE=100
MARKET_MATCHING_BLOCK_MS=5000
MARKET_MATCHING_PENDING_IDLE_MS=60000
MARKET_MATCHING_MAX_RETRIES=10
MARKET_MATCHING_FAILURE_TTL_SECONDS=604800
FUTURES_MATCHING_DEAD_LETTER_STREAM=stream:market-ticks:futures:matching:dead-letter
SECURITIES_MATCHING_DEAD_LETTER_STREAM=stream:market-ticks:securities:matching:dead-letter
FUTURES_ARRIVAL_DEAD_LETTER_STREAM=stream:orders:arrival-matching:futures:dead-letter
SECURITIES_ARRIVAL_DEAD_LETTER_STREAM=stream:orders:arrival-matching:securities:dead-letter
MARKET_MATCHING_RETRY_INTERVAL_SECONDS=1
# 撮合引擎名称不区分大小写，当前内置VN。
MATCHING_ENGINE_NAME=VN

# 盘中实时盈亏Consumer与活动持仓缓存
PNL_CONSUMER_GROUP=group:pnl-engine
PNL_CONSUMER_NAME=
PNL_CONSUMER_BATCH_SIZE=100
PNL_CONSUMER_BLOCK_MS=5000
PNL_PENDING_IDLE_MS=60000
PNL_EVENT_MAX_RETRIES=10
PNL_FAILURE_TTL_SECONDS=604800
PNL_DEAD_LETTER_STREAM=stream:market-ticks:futures:pnl:dead-letter
PNL_CONSUMER_RETRY_INTERVAL_SECONDS=1
PNL_CALCULATION_INTERVAL_MS=500

# 统一账户实时风险监控。恢复阈值必须低于预警阈值，预警阈值必须低于强平阈值。
RISK_WARNING_RATIO=0.80
RISK_LIQUIDATION_RATIO=1.00
RISK_RECOVERY_RATIO=0.75
RISK_MONITOR_INTERVAL_MS=500
RISK_MONITOR_BATCH_SIZE=100
RISK_MAX_ACTIONS_PER_CYCLE=10
RISK_LIQUIDATION_MAX_RETRIES=10
RISK_WORKER_LEASE_TTL_SECONDS=15
RISK_WORKER_LEASE_RENEW_SECONDS=5
RISK_FULL_RECONCILIATION_INTERVAL_SECONDS=60
PNL_FULL_RECONCILIATION_INTERVAL_SECONDS=60
PNL_WORKER_LEASE_TTL_SECONDS=15
PNL_WORKER_LEASE_RENEW_SECONDS=5
ACTIVE_POSITION_CACHE_REFRESH_MS=60000

# PostgreSQL盈亏快照批量持久化
PNL_PERSIST_INTERVAL_MS=1000
PNL_PERSIST_BATCH_SIZE=500
PNL_PERSIST_MAX_BATCHES_PER_CYCLE=10
PNL_PERSIST_TIME_BUDGET_MS=800
VALUATION_PERSIST_INTERVAL_MS=1000
VALUATION_PERSIST_BATCH_SIZE=500

# 成交事件驱动的活动持仓缓存失效
PNL_TRADE_CONSUMER_GROUP=group:pnl-trade-engine
PNL_TRADE_CONSUMER_NAME=
PNL_TRADE_CONSUMER_BATCH_SIZE=100
PNL_TRADE_CONSUMER_BLOCK_MS=5000
PNL_TRADE_PENDING_IDLE_MS=60000
PNL_TRADE_EVENT_MAX_RETRIES=10
PNL_TRADE_FAILURE_TTL_SECONDS=604800
PNL_TRADE_DEAD_LETTER_STREAM=stream:orders:pnl:dead-letter
PNL_TRADE_RETRY_INTERVAL_SECONDS=1

# WebSocket统一实时事件投影
REALTIME_EVENT_STREAM_NAME=stream:realtime-events
REALTIME_EVENT_STREAM_MAXLEN=1000000
REALTIME_PROJECTION_CONSUMER_GROUP=group:realtime-projection
REALTIME_PROJECTION_CONSUMER_NAME=
REALTIME_PROJECTION_BATCH_SIZE=100
REALTIME_PROJECTION_BLOCK_MS=5000
REALTIME_PROJECTION_PENDING_IDLE_MS=60000
REALTIME_PROJECTION_MAX_RETRIES=10
REALTIME_PROJECTION_FAILURE_TTL_SECONDS=604800
REALTIME_PROJECTION_DEAD_LETTER_STREAM=stream:orders:realtime:dead-letter

# 第一版WebSocket Gateway固定单实例、单Uvicorn Worker
WS_GATEWAY_CONSUMER_GROUP=group:ws-gateway
WS_GATEWAY_CONSUMER_NAME=
WS_GATEWAY_BATCH_SIZE=100
WS_GATEWAY_BLOCK_MS=1000
WS_GATEWAY_PENDING_IDLE_MS=60000
WS_GATEWAY_DEAD_LETTER_STREAM=stream:realtime-events:dead-letter
WS_TICKET_EXPIRE_SECONDS=30
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_HEARTBEAT_TIMEOUT_SECONDS=60
WS_AUTH_RECHECK_INTERVAL_SECONDS=60
WS_SEND_QUEUE_SIZE=500
WS_SNAPSHOT_BUFFER_SIZE=1000
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=20
WS_MAX_CONNECTIONS_PER_USER=5
WS_GATEWAY_LEASE_TTL_SECONDS=30
WS_GATEWAY_LEASE_RENEW_SECONDS=10
WS_GATEWAY_HOST=0.0.0.0
WS_GATEWAY_PORT=8001
